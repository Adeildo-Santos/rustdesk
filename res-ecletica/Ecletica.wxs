<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador unico Ecletica Connect (dual-arch).
  - Pacote marcado 32 bits (roda em qualquer Windows).
  - Em Windows 64 bits instala o cliente Flutter (payload\x64, Condition VersionNT64).
  - Em Windows 32 bits instala o cliente sciter legado (payload\x86).
  A config de rede (servidor/relay/api/key) ja vem embutida nos dois binarios,
  entao o MSI nao injeta .toml nem mexe em C:\Users, taskkill ou sc.
  Os componentes por arquivo vem de Payload.wxs (gerado por gen_components.py).
  UpgradeCode igual ao do MSI de 64 bits atual, para atualizar por cima da base.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?define Product = "Ecletica Connect" ?>
  <?define Manufacturer = "Eclética" ?>
  <?define UpgradeCode = "D3DC41E3-3C37-5D52-BB47-F6673705C01B" ?>
  <?ifndef Version ?><?define Version = "1.5.20" ?><?endif?>

  <Package Name="$(var.Product)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1046"
           Codepage="1252"
           Scope="perMachine">

    <SummaryInformation Keywords="Installer" Description="$(var.Product) - instalador (64 e 32 bits)" />
    <Media Id="1" Cabinet="cab1.cab" EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://app.ecletico.ai" />

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do $(var.Product) já está instalada."
                  Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes" />

    <!-- Pasta de instalacao: forca o Program Files real no Windows 64 bits
         (o pacote e 32 bits e cairia em Program Files (x86)). Duas CustomActions
         distintas para nao colidir o Id ao condicionar por arquitetura. -->
    <CustomAction Id="SetInstX64" Property="INSTALLFOLDER"
                  Value="[%ProgramW6432]\$(var.Product)" />
    <CustomAction Id="SetInstX86" Property="INSTALLFOLDER"
                  Value="[ProgramFilesFolder]$(var.Product)" />
    <InstallUISequence>
      <Custom Action="SetInstX64" Before="CostFinalize" Condition="VersionNT64" />
      <Custom Action="SetInstX86" Before="CostFinalize" Condition="NOT VersionNT64" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="SetInstX64" Before="CostFinalize" Condition="VersionNT64" />
      <Custom Action="SetInstX86" Before="CostFinalize" Condition="NOT VersionNT64" />
      <Custom Action="LaunchTray" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="$(var.Product)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="$(var.Product)" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="StartupFolder" />

    <!-- Apos instalar, sobe o processo da bandeja (modo tray) na sessao do usuario.
         E ele, junto com o servico, que injeta o input e lida com a tela do UAC;
         sem isso da para ver a tela mas nao clicar. (instalacao interativa) -->
    <CustomAction Id="LaunchTray" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]Ecletica Connect.exe&quot; --tray"
                  Return="asyncNoWait" Impersonate="yes" />

    <Feature Id="Main" Title="$(var.Product)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="Payload" />
      <ComponentGroupRef Id="SharedShortcuts" />
    </Feature>
  </Package>

  <!-- Atalhos (servem para as duas arquiteturas; o exe tem sempre o mesmo nome/pasta) -->
  <Fragment>
    <ComponentGroup Id="SharedShortcuts">
      <Component Id="Shortcuts" Directory="AppMenuFolder" Guid="*">
        <Shortcut Id="DesktopSc" Directory="DesktopFolder" Name="$(var.Product)"
                  Target="[INSTALLFOLDER]Ecletica Connect.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="MenuSc" Name="$(var.Product)"
                  Target="[INSTALLFOLDER]Ecletica Connect.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <!-- Sobe a bandeja no logon de qualquer usuario (necessario p/ injetar input) -->
        <Shortcut Id="TraySc" Directory="StartupFolder" Name="$(var.Product) Tray"
                  Target="[INSTALLFOLDER]Ecletica Connect.exe" Arguments="--tray"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Ecletica\Connect"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
